[Unit]
Description=BaoClaw AI Coding Assistant Daemon
Documentation=https://github.com/baohx/BaoClaw
After=network.target

[Service]
Type=simple
# daemon 二进制路径（install.sh 安装到 ~/.baoclaw/bin/）
ExecStart=%h/.baoclaw/bin/baoclaw-core --daemon
# 或从源码编译：ExecStart=%h/BaoClaw/target/release/baoclaw-core --daemon
# 或 cargo 安装：ExecStart=%h/.cargo/bin/baoclaw-core --daemon
WorkingDirectory=%h
Environment=RUST_LOG=info
Environment=BAOCLAW_DAEMON_MODE=1
# 重启策略
Restart=on-failure
RestartSec=5
# 资源限制
LimitNOFILE=4096
MemoryMax=2G

[Install]
WantedBy=default.target
