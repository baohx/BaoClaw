{
  "name": "book2-agent-harness",
  "version": "1.0.0",
  "type": "module",
  "description": "Agent Harness 技术书籍 - HTML 幻灯片风格呈现",
  "main": "dist/bundle.js",
  "scripts": {
    "dev": "npx http-server . -p 3000 -o",
    "build": "node --loader ts-node/esm scripts/build.ts",
    "watch": "node --loader ts-node/esm scripts/build.ts --watch",
    "serve": "npx http-server dist -p 3000",
    "preview": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "validate": "ts-node scripts/validate.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "agent",
    "harness",
    "rust",
    "ai",
    "llm",
    "book",
    "slides"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.55.0",
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "highlight.js": "^11.9.0",
    "marked": "^11.1.0",
    "mermaid": "^11.15.0"
  }
}
